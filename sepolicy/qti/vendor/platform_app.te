# Android 16 splits platform apps into versioned domains: platform_app is for
# recent targetSdk, platform_app_36 for targetSdk <= 36. Both need to act as
# camera (postproc) HAL clients for the OPlus camera stack.
typeattribute platform_app hal_camera_client;
typeattribute platform_app_36 hal_camera_client;
typeattribute platform_app_36 halclientdomain;

allow { platform_app platform_app_36 } adsprpcd_file:dir r_dir_perms;

allow { platform_app platform_app_36 } oem_service:service_manager find;

allow { platform_app platform_app_36 } public_adsprpcd_file:file r_file_perms;

allow { platform_app platform_app_36 } vendor_camera_data_file:dir getattr;

allow { platform_app platform_app_36 } vendor_sysfs_kgsl:file r_file_perms;

allow { platform_app platform_app_36 } vendor_xdsp_device:chr_file r_file_perms;

rw_dir_file({ platform_app platform_app_36 }, vendor_sysfs_battery_supply)

binder_call({ platform_app platform_app_36 }, hal_camera_default)
